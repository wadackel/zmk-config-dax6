#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <mouse-gesture.dtsi>

// Ctrl+Alt+Shift+Meta as a single modifier. The keycode itself is a modifier
// usage, so it lands in the HID modifier byte and a bare tap sends no character.
#define HYPER LC(LS(LA(LGUI)))

#define ANDROID 1
#define MOUSE 5
#define SCROLL 6
#define NUM 3
#define MAC_GESTURE 8

&zip_mouse_gesture {
    stroke-size = <300>;
    enable-eager-mode;
    suppress-movement;
    idle-timeout-ms = <150>;
    gesture-cooldown-ms = <200>;

    g_back {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(LEFT_BRACKET)>;
    };

    g_fwd {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(RIGHT_BRACKET)>;
    };

    g_top {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(UP_ARROW)>;
    };

    g_bottom {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(DOWN_ARROW)>;
    };
};

/ {
    zip_mouse_gesture_mac: zip_mouse_gesture_mac {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        stroke-size = <300>;
        enable-eager-mode;
        always-active;
        idle-timeout-ms = <150>;
        gesture-cooldown-ms = <200>;

        mg_desktop {
            pattern = <GESTURE_UP>;
            bindings = <&kp F11>;
        };

        mg_mission_control {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp RC(UP_ARROW)>;
        };

        mg_app_expose {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp RC(DOWN)>;
        };

        mg_spotlight {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LG(SPACE)>;
        };
    };


    // A layer override can never suppress movement: input_listener.c:223-225 returns 0
    // instead of the chain's ZMK_INPUT_PROC_STOP, so `suppress-movement` only takes
    // effect from the base chain. Renaming the Android chain's axes to RX/RY hides
    // them from the macOS gesture node and from the base transform, which lets the
    // Android gesture node sit in the base chain and stop the cursor for real.
    // RX/RY never reach the host — handle_rel_code() only knows X/Y/WHEEL/HWHEEL —
    // so the base chain has to rename them back on the way out.
    zip_xy_to_gesture_axis: zip_xy_to_gesture_axis {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        map
            = <INPUT_REL_X INPUT_REL_RX>
            , <INPUT_REL_Y INPUT_REL_RY>
            ;
    };

    zip_gesture_axis_to_xy: zip_gesture_axis_to_xy {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        map
            = <INPUT_REL_RX INPUT_REL_X>
            , <INPUT_REL_RY INPUT_REL_Y>
            ;
    };

    zip_mouse_gesture_android: zip_mouse_gesture_android {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        event-code-x = <INPUT_REL_RX>;
        event-code-y = <INPUT_REL_RY>;
        stroke-size = <300>;
        enable-eager-mode;
        suppress-movement;
        idle-timeout-ms = <150>;
        gesture-cooldown-ms = <200>;

        g_back {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp C_AC_BACK>;
        };
    };
};

// Encoder scroll reaches the host through &msc, which owns its own input-listener.
// The listener lives in behaviors.dtsi, which the shield overlay is parsed before,
// so the Android direction flip has to be declared here rather than in the overlay.
&msc_input_listener {
    android_encoder_override {
        layers = <ANDROID>;
        input-processors
            = <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>
            , <&zip_scroll_scaler 3 5>
            ;
    };
};

&mt {
    quick-tap-ms = <0>;
    tapping-term-ms = <160>;
    flavor = "balanced";
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <160>;
    quick-tap-ms = <0>;
};

// The rsr_* behaviors below are compile-time defaults for the encoders. DYA
// Studio overrides them per sensor and layer at runtime, and a layer only
// becomes editable there when its sensor-bindings resolve to one of them.
// Every variant sets tap-ms to 20, including the &kp ones: &msc ticks every
// 16 ms, and DYA Studio reuses a layer's current tap-ms when it rebinds, so the
// binding default of 5 would leave a later &msc silent.
/ {
    combos {
        compatible = "zmk,combos";

        to_device {
            bindings = <&mo 7>;
            key-positions = <0 29>;
            layers = <0 1>;
        };

        kl_scroll {
            bindings = <&mo 6>;
            key-positions = <20 21>;
            layers = <0 1>;
        };

        to_device_left {
            bindings = <&tog 7>;
            key-positions = <0 12 24>;
            layers = <0 1>;
        };

        to_device_right {
            bindings = <&tog 7>;
            key-positions = <11 23 37>;
            layers = <0 1>;
        };
    };

    macros {
        esc_lang2: esc_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp ESCAPE &kp LANG2>;
        };
    };

    behaviors {
        esc_lang2_with_layer: esc_lang2_with_layer {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&esc_lang2>;
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "balanced";
        };

        rsr_scroll: rsr_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_UP>;
            ccw-binding = <&msc SCRL_DOWN>;
        };

        rsr_scroll_rev: rsr_scroll_rev {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        rsr_hscroll: rsr_hscroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_RIGHT>;
            ccw-binding = <&msc SCRL_LEFT>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
        };

        rsr_bri: rsr_bri {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&kp C_BRI_INC>;
            ccw-binding = <&kp C_BRI_DEC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB          &kp Q   &kp W   &kp E          &kp R                &kp T                                                                              &kp Y         &kp U   &kp I       &kp O     &kp P             &kp MINUS
&kp LCTRL        &kp A   &kp S   &kp D          &kp F                &kp G                                                                              &kp H         &kp J   &kp K       &kp L     &lt 5 SEMICOLON   &lt 6 SINGLE_QUOTE
&kp LEFT_SHIFT   &kp Z   &kp X   &kp C          &kp V                &kp B                  &kp BACKSPACE                               &kp BACKSPACE   &kp N         &kp M   &kp COMMA   &kp DOT   &kp SLASH         &mkp MB1
                                 &kp LEFT_ALT   &mt LEFT_GUI LANG2   &mt LEFT_SHIFT SPACE   &esc_lang2_with_layer 4 0                   &lt 3 ENTER     &lt 2 LANG1
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };

        Android {
            bindings = <
&trans   &trans   &trans   &trans   &trans            &trans                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans            &trans                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans            &trans   &trans                   &trans   &trans   &trans   &trans   &trans   &trans   &trans
                           &trans   &mt HYPER LANG2   &trans   &trans                   &trans   &trans
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };

        Symbol {
            bindings = <
&trans   &kp TILDE         &kp GRAVE       &kp DOLLAR         &kp PERCENT   &kp CARET                                         &trans      &kp AMPERSAND    &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS   &trans      &trans
&trans   &kp EXCLAMATION   &kp AT_SIGN     &kp HASH           &kp EQUAL     &kp PLUS                                          &kp ASTRK   &kp UNDERSCORE   &kp LEFT_BRACKET       &kp RIGHT_BRACKET       &kp COLON   &kp DOUBLE_QUOTES
&trans   &kp QUESTION      &kp LESS_THAN   &kp GREATER_THAN   &kp PIPE      &kp BACKSLASH   &trans                   &trans   &trans      &trans           &kp LEFT_BRACE         &kp RIGHT_BRACE         &trans      &trans
                                           &trans             &trans        &trans          &trans                   &trans   &trans
            >;

            sensor-bindings = <&rsr_hscroll>, <&rsr_hscroll>;
        };

        Num {
            bindings = <
&trans   &kp SLASH      &kp N7         &kp N8         &kp N9         &kp MINUS                                           &trans          &trans   &trans   &trans   &trans      &trans
&trans   &kp ASTERISK   &kp NUMBER_4   &kp N5         &kp NUMBER_6   &kp PLUS                                            &kp BACKSPACE   &trans   &trans   &trans   &kp COLON   &trans
&trans   &kp N0         &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp PERCENT   &trans                       &trans   &trans          &trans   &trans   &trans   &trans      &trans
                                       &trans         &trans         &trans        &kp PERIOD                   &trans   &trans
            >;

            sensor-bindings = <&rsr_vol>, <&rsr_bri>;
        };

        Function {
            bindings = <
&kp LG(LS(N7))   &kp LG(LS(NUMBER_4))       &kp F7   &kp F8   &kp F9   &kp LG(SPACE)                                         &kp C_MUTE   &kp C_PP   &kp C_VOLUME_DOWN   &kp C_VOLUME_UP   &trans   &trans
&trans           &kp LG(LC(LS(NUMBER_4)))   &kp F4   &kp F5   &kp F6   &kp LG(LC(SPACE))                                     &kp LEFT     &kp DOWN   &kp UP_ARROW        &kp RIGHT         &trans   &trans
&trans           &kp F10                    &kp F1   &kp F2   &kp F3   &mo 7               &trans                   &trans   &trans       &trans     &trans              &trans            &trans   &trans
                                                     &trans   &trans   &trans              &trans                   &trans   &trans
            >;

            sensor-bindings = <&rsr_vol>, <&rsr_bri>;
        };

        Mouse {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                                                       &kp F11                     &kp RG(R)   &mo MAC_GESTURE   &mouse_gesture   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                                                       &kp RC(UP_ARROW)            &mkp MB1    &mkp MB3          &mkp MB2         &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans                   &trans                     &kp RC(DOWN)                &mkp MB4    &mkp MB5          &kp RG(W)        &trans   &trans
                           &trans   &trans   &trans   &trans                   &kp RG(RS(LEFT_BRACKET))   &kp RG(RS(RIGHT_BRACKET))
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };

        Scroll {
            bindings = <
&trans   &trans   &trans                     &kp LG(LC(LA(K)))          &kp LG(LC(LA(M)))          &kp LG(LC(LA(C)))                                                 &trans            &trans   &trans   &trans   &trans   &trans
&trans   &trans   &kp LG(LC(LA(LEFT)))       &kp LC(LA(UP_ARROW))       &kp LG(LC(LA(DOWN)))       &kp LG(LC(LA(RIGHT)))                                             &trans            &trans   &trans   &trans   &trans   &trans
&trans   &trans   &kp LG(LC(LA(NUMBER_1)))   &kp LG(LC(LA(NUMBER_2)))   &kp LG(LC(LA(NUMBER_3)))   &kp LG(LC(LA(NUMBER_4)))   &trans                   &trans        &trans            &trans   &trans   &trans   &trans   &trans
                                             &trans                     &trans                     &trans                     &trans                   &kp LC(TAB)   &kp LC(LS(TAB))
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };

        Device {
            bindings = <
&bootloader   &trans   &trans   &trans   &trans   &tog 7                                     &tog 7         &trans         &trans         &bt BT_CLR     &bt BT_CLR_ALL   &bootloader
&trans        &trans   &trans   &trans   &trans   &trans                                     &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4     &trans
&trans        &trans   &trans   &trans   &trans   &trans   &trans                   &trans   &trans         &bt BT_PRV     &bt BT_NXT     &trans         &trans           &trans
                                &trans   &trans   &trans   &trans                   &trans   &trans
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };

        MacGesture {
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                                     &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans                   &trans   &trans   &trans   &trans   &trans   &trans   &trans
                           &trans   &trans   &trans   &trans                   &trans   &trans
            >;

            sensor-bindings = <&rsr_scroll>, <&rsr_scroll_rev>;
        };
    };
};
