#include "dax6.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include "trackball_processors.dtsi"

&xiao_serial {
  status = "disabled";
};

&default_transform {
  col-offset = <7>;
};

&kscan0 {
  col-gpios
    = <&xiao_d 4 GPIO_ACTIVE_HIGH> // D4/P0.04 -> Col0
    , <&xiao_d 5 GPIO_ACTIVE_HIGH> // D5/P0.05 -> Col1
    , <&xiao_d 6 GPIO_ACTIVE_HIGH> // D6/P1.11 -> Col2
    , <&gpio0 15 GPIO_ACTIVE_HIGH> // P0.15 -> Col3
    , <&gpio0 19 GPIO_ACTIVE_HIGH> // P0.19 -> Col4
    , <&gpio1 1 GPIO_ACTIVE_HIGH>  // P1.01 -> Col5
    , <&gpio0 9 GPIO_ACTIVE_HIGH>  // GP 0.09 -> Col6
    ;
};

/ {
  trackball_listener {
    compatible = "zmk,input-listener";
    device = <&trackball>;
    // The gesture processor picks its profile by layer and stops the pointer by zeroing the
    // movement, so it needs no override of its own and works under the ones below.
    input-processors = <&tb_pointer>, <&dax_gestures>;

    scroll_override {
      layers = <6>;  // SCROLL layer
      process-next;
      input-processors
        = <&tb_pointer>
        , <&zip_xy_to_scroll_mapper>
        , <&tb_scroll>
        ;
    };

    // Declared last and with `process-next`: the Android layer is permanently active while its
    // BLE profile is selected, so it must neither shadow the Scroll override nor end the chain.
    // It only flips the wheel the Scroll override produced; X/Y pass through untouched.
    android_override {
      layers = <1>;  // ANDROID layer
      process-next;
      input-processors = <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>;
    };
  };
};

&pinctrl {
  spi0_default: spi0_default {
    group1 {
      psels = <NRF_PSEL(SPIM_SCK, 1, 13)>, // P1.13 (D8/SCLK)
        <NRF_PSEL(SPIM_MOSI, 1, 15)>,      // P1.15 (D10/SDIO)
        <NRF_PSEL(SPIM_MISO, 1, 15)>;      // P1.15 (D10/SDIO)
    };
  };

  spi0_sleep: spi0_sleep {
    group1 {
      psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
        <NRF_PSEL(SPIM_MOSI, 1, 15)>,
        <NRF_PSEL(SPIM_MISO, 1, 15)>;
      low-power-enable;
    };
  };
};

&spi0 {
  status = "okay";
  compatible = "nordic,nrf-spim";
  pinctrl-0 = <&spi0_default>;
  pinctrl-1 = <&spi0_sleep>;
  pinctrl-names = "default", "sleep";
  cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;  // P0.10 (CS)

  trackball: trackball@0 {
    status = "okay";
    compatible = "pixart,paw3222";
    reg = <0>;
    spi-max-frequency = <2000000>;
    irq-gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  // P1.12 (D7/MOTION)
    res-cpi = <1400>;
  };
};

&right_encoder {
  a-gpios = <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // P1.03/RE_A
  b-gpios = <&gpio1 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // P1.05/RE_B
  status = "okay";
};
